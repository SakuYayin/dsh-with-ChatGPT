{
  "name": "dsh-with-chatgpt",
  "version": "0.1.0",
  "private": true,
  "description": "ChatGPT thinks. DSH works. A read-only MCP bridge that lets ChatGPT web plan and review while your local DSH agent edits, runs and tests.",
  "type": "module",
  "main": "lib/entry.js",
  "icon": "./icon.svg",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./lib/entry.js",
    "./client": "./lib/client.js",
    "./icon": "./icon.svg",
    "./locale/en.json": "./locale/en.json",
    "./locale/zh.json": "./locale/zh.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "README.fr-FR.md",
    "README.ru-RU.md",
    "README.ja-JP.md",
    "README.ko-KR.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "dependencies": {}
}
